# Bash terminal style
export PS1='\[\033[36m\]\u\[\033[m\]@\[\033[32m\]\h:\
\[\033[33;1m\]\w\[\033[m\]$(__git_ps1 "(%s)")\[\033[35m\]${GWS_ACCOUNT:+[gws:$GWS_ACCOUNT]}\[\033[m\]\$ '
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
export EDITOR=vim

# Git completions
source /opt/homebrew/etc/bash_completion.d/git-completion.bash
source /opt/homebrew/etc/bash_completion.d/git-prompt.sh

# Maximum number of history lines in memory
export HISTSIZE=50000
# Maximum number of history lines on disk
export HISTFILESIZE=50000
# Ignore duplicate lines
export HISTCONTROL=ignoredups:erasedups
# When the shell exits, append to the history file instead of overwriting it
shopt -s histappend

# Ignore macOS Catalina bash deprecation warning
export BASH_SILENCE_DEPRECATION_WARNING=1

# fzf, a general-purpose command-line fuzzy finder
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

# gws (Google Workspace CLI) multi-account wrapper.
# Account resolution and credential isolation live in ~/.local/bin/gws
# (canonical copy: ~/.dotfiles/bin/gws) so non-bash callers get the same
# enforcement. This function only adds what a child process can't: a sticky
# per-shell account (GWS_ACCOUNT, shown in PS1) and --switch to change it.
# Exported so non-interactive shells (e.g. Claude Code) resolve accounts too.
export GWS_ACCOUNTS_DIR="$HOME/.config/gws/accounts"

gws() {
    local script="$HOME/.local/bin/gws"
    if [ ! -x "$script" ]; then
        echo "gws: $script missing — run ~/.dotfiles/script/bootstrap" >&2
        return 127
    fi

    local switch=false one_shot="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --switch)
                switch=true; shift ;;
            --account)
                [ -n "${2:-}" ] || { echo "gws: --account requires a value" >&2; return 2; }
                one_shot="$2"; shift 2 ;;
            *)
                args+=("$1"); shift ;;
        esac
    done

    # Explicit account: one-shot, doesn't touch the sticky choice.
    if [ -n "$one_shot" ]; then
        "$script" --account "$one_shot" "${args[@]}"
        return
    fi

    # Non-interactive: don't trust an inherited sticky GWS_ACCOUNT —
    # identity must be explicit in scripts. The script enforces that.
    if [ ! -t 0 ]; then
        "$script" "${args[@]}"
        return
    fi

    if [ "$switch" = true ] || [ -z "$GWS_ACCOUNT" ]; then
        local account
        account=$("$script" --list-accounts | fzf --prompt="gws account> " --height=~10) || return 1
        [ -n "$account" ] || return 1
        export GWS_ACCOUNT="$account"
    fi
    "$script" --account "$GWS_ACCOUNT" "${args[@]}"
}

# OrbStack (no admin helper)
export PATH="$HOME/.orbstack/bin:$PATH"
export DOCKER_HOST="unix://$HOME/.orbstack/run/docker.sock"
