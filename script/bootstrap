#!/usr/bin/env bash
#
# bootstrap installs things.

DOTFILES_ROOT="`pwd`"

set -e

echo ''

info () {
  printf "  [ \033[00;34m..\033[0m ] $1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] $1 "
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

# Wipes the current line. Each pass prints a banner with no trailing newline,
# on the assumption that the first success() will overwrite it. When a pass has
# nothing to do there is no success() to do that, so it clears its own banner.
clear_line () {
  printf "\r\033[2K"
}

link_files () {
  mkdir -p "`dirname \"$2\"`"
  ln -s "$1" "$2"
  success "linked $1 to $2"
}

# Answers to the overwrite/backup/skip prompt. Global so that an "all" answer
# given once applies to every pass for the rest of the run.
overwrite_all=false
backup_all=false
skip_all=false

# Links one source to one destination, prompting if something is already there.
link_one () {
  local source="$1"
  local dest="$2"
  local overwrite=false backup=false skip=false action

  # Already pointing where we want it: do nothing and say nothing. Re-running
  # bootstrap should be quiet.
  if [ -L "$dest" ] && [ "`readlink \"$dest\"`" = "$source" ]
  then
    return
  fi

  # -e answers "is there something here?" for real files and for symlinks that
  # resolve, but reports false on a broken symlink -- hence the -L as well.
  if [ ! -e "$dest" ] && [ ! -L "$dest" ]
  then
    link_files "$source" "$dest"
    return
  fi

  if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
  then
    user "File already exists: $dest, what do you want to do? [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
    read -n 1 action

    case "$action" in
      o )
        overwrite=true;;
      O )
        overwrite_all=true;;
      b )
        backup=true;;
      B )
        backup_all=true;;
      s )
        skip=true;;
      S )
        skip_all=true;;
      * )
        ;;
    esac
  fi

  if [ "$overwrite" == "true" ] || [ "$overwrite_all" == "true" ]
  then
    rm -rf "$dest"
    success "removed $dest"
  fi

  if [ "$backup" == "true" ] || [ "$backup_all" == "true" ]
  then
    mv "$dest" "$dest"\.backup
    success "moved $dest to $dest.backup"
  fi

  if [ "$skip" == "false" ] && [ "$skip_all" == "false" ]
  then
    link_files "$source" "$dest"
  else
    success "skipped $source"
  fi
}

# <flat $HOME path>:<the config/ path that replaced it>
#
# Leaving a migrated flat link behind is not harmless, and each tool fails
# differently: git reads ~/.gitconfig on top of the XDG file and wins key by
# key, tmux loads both configs additively, and ~/.vimrc shadows
# ~/.config/vim/vimrc outright.
LEGACY_LINKS="
.gitconfig:git/config
.gitignore:git/ignore
.tmux.conf:tmux/tmux.conf
.vimrc:vim/vimrc
.vim:vim
"

# Only ever unlinks symlinks that resolve back into this repo. A real file, or
# a link to somewhere else, belongs to the user and is left alone.
prune_legacy_links () {
  info 'pruning legacy links'

  local entry name replacement dest target

  for entry in $LEGACY_LINKS
  do
    name="${entry%%:*}"
    replacement="${entry#*:}"

    # Nothing has replaced this yet, so the flat link is still the live one.
    # Pruning here would just fight install_dotfiles, which would relink it
    # from the *.symlink source on the very same run.
    [ -e "$DOTFILES_ROOT/config/$replacement" ] || continue

    dest="$HOME/$name"

    [ -L "$dest" ] || continue
    target="`readlink \"$dest\"`"

    case "$target" in
      "$DOTFILES_ROOT"/*)
        rm "$dest"
        success "unlinked stale $dest";;
    esac
  done

  clear_line
}

# <topic>/<name>.symlink -> ~/.<name>
install_dotfiles () {
  info 'installing dotfiles'

  local source dest

  for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`
  do
    dest="$HOME/.`basename \"${source%.*}\"`"
    link_one "$source" "$dest"
  done

  clear_line
}

# config/<path> -> $XDG_CONFIG_HOME/<path>, recursively. Files are linked
# individually rather than linking whole directories, so that a tool writing
# its own state next to a config file does not end up writing into this repo.
install_config () {
  info 'installing config'

  local root="$DOTFILES_ROOT/config"
  local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
  local source dest

  if [ ! -d "$root" ]
  then
    clear_line
    return
  fi

  for source in `find $root -type f`
  do
    dest="$xdg/${source#$root/}"
    link_one "$source" "$dest"
  done

  clear_line
}

prune_legacy_links
install_dotfiles
install_config

echo ''
echo '  All installed!'
