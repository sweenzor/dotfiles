[user]
    name = Matthew Sweeney
    email = mattswe@gmail.com

[includeIf "gitdir:~/src/"]
    path = ~/src/.gitconfig

[color]
    diff = auto
    status = auto
    branch = auto
    interactive = auto

[url "git@github.com:"]
	# pushInsteadOf, not insteadOf: fetch/clone stay on HTTPS (gh token, no
	# 1Password prompt); only pushes go over SSH and touch the key.
	pushInsteadOf = https://github.com/

[branch]
    autosetuprebase = always

[diff]
    compactionHeuristic = true

[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
